    <property name="defaultTime" display-name-key="Default_Time" description-key="Default_Time_Desc" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="format" display-name-key="Format" description-key="Format_Desc" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="resetKey" display-name-key="Reset_Key" description-key="Reset_Key_Desc" of-type="TwoOptions" usage="input" required="false" />
